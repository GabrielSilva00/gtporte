# O app le o .env da raiz do repositorio (envDir em vite.config.ts), entao em
# desenvolvimento nao e preciso criar um .env aqui.
# Na Vercel, defina estas variaveis no projeto do app do motorista:
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Opcional: chave publica VAPID (a mesma do app do estudante) para avisos
# chegarem com o app fechado. Sem ela, so chegam com o app aberto.
VITE_VAPID_PUBLIC_KEY=
